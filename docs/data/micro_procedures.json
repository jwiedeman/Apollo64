{
  "version": 1,
  "description": "Micro-level procedural commands - every switch, every button, every action",
  "notes": "Based on Apollo 11 Flight Plan and Crew Checklist. Each macro step is broken into individual control actuations.",
  "procedures": [
    {
      "id": "PROC_LAUNCH_T_MINUS_5",
      "name": "Launch T-5 Minutes",
      "phase": "Launch",
      "getStartSeconds": -300,
      "crewRole": "Joint",
      "commands": [
        {
          "getSeconds": -300,
          "type": "VERIFY",
          "commandId": "VERIFY_CABIN_PRESS",
          "description": "Verify cabin pressure 5.0 psia",
          "panel": "CSM_CRYO_ECS",
          "expectedValue": "5.0 psia"
        },
        {
          "getSeconds": -295,
          "type": "SWITCH",
          "commandId": "SEQ_EVENTS_CTRL",
          "description": "SEQ EVENTS CTRL - ARM",
          "panel": "CSM_CB_LEFT",
          "control": "CB_CMC",
          "expectedState": "CLOSED"
        },
        {
          "getSeconds": -290,
          "type": "VERIFY",
          "commandId": "VERIFY_FC_CURRENT",
          "description": "Verify fuel cell current balanced",
          "panel": "CSM_ELECTRICAL_POWER",
          "expectedValue": "balanced"
        },
        {
          "getSeconds": -280,
          "type": "SWITCH",
          "commandId": "FDAI_POWER_ON",
          "description": "FDAI 1 - POWER ON",
          "panel": "CSM_FLIGHT_CONTROL",
          "control": "FDAI_SOURCE",
          "expectedState": "CMC"
        },
        {
          "getSeconds": -270,
          "type": "SWITCH",
          "commandId": "ATT_SET_GDC",
          "description": "ATT SET - GDC",
          "panel": "CSM_FLIGHT_CONTROL",
          "control": "ATTITUDE_HOLD",
          "expectedState": "CMC"
        },
        {
          "getSeconds": -260,
          "type": "CALLOUT",
          "commandId": "CALLOUT_GUIDANCE_GO",
          "description": "\"Guidance is go\"",
          "crewRole": "CMP"
        },
        {
          "getSeconds": -240,
          "type": "DSKY",
          "commandId": "DSKY_V37E00E",
          "description": "V37E00E - Idle program",
          "verb": 37,
          "noun": 0,
          "panel": "DSKY"
        },
        {
          "getSeconds": -200,
          "type": "VERIFY",
          "commandId": "VERIFY_PYRO_ARM",
          "description": "Verify pyro buses armed",
          "panel": "CSM_SCS_DAP",
          "expectedValue": "armed"
        },
        {
          "getSeconds": -180,
          "type": "CALLOUT",
          "commandId": "CALLOUT_T3_MIN",
          "description": "\"T minus 3 minutes\"",
          "crewRole": "CDR"
        },
        {
          "getSeconds": -120,
          "type": "SWITCH",
          "commandId": "SUIT_FLOW_CABIN",
          "description": "SUIT FLOW - SUIT",
          "panel": "CSM_CRYO_ECS",
          "control": "SUIT_FAN_SELECT",
          "expectedState": "A"
        },
        {
          "getSeconds": -60,
          "type": "CALLOUT",
          "commandId": "CALLOUT_T1_MIN",
          "description": "\"T minus 1 minute\"",
          "crewRole": "CDR"
        },
        {
          "getSeconds": -30,
          "type": "VERIFY",
          "commandId": "VERIFY_RANGE_SAFETY",
          "description": "Range safety GO",
          "expectedValue": "GO"
        },
        {
          "getSeconds": -15,
          "type": "CALLOUT",
          "commandId": "CALLOUT_GUIDANCE_REL",
          "description": "\"Guidance release\"",
          "crewRole": "CMP"
        },
        {
          "getSeconds": -9,
          "type": "VERIFY",
          "commandId": "VERIFY_IGN_SEQ",
          "description": "Ignition sequence start",
          "expectedValue": "started"
        }
      ]
    },
