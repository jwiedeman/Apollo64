          "commandId": "CALLOUT_STAGING",
          "description": "\"Staging\"",
          "crewRole": "CDR"
        },
        {
          "getSeconds": 163.5,
          "type": "VERIFY",
          "commandId": "VERIFY_S2_IGN",
          "description": "S-II ignition",
          "expectedValue": "ignition"
        }
      ]
